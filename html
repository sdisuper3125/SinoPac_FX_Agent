 const gr=v=>GROSS*v/1e4, un=v=>NET*v/1e4, he=v=>(NET-planUsd())*v/1e4;
 let g=`<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-label="升值情境與少收金額"><g font-family="IBM Plex Mono, monospace" font-size="12" fill="#8A929B">`;
 [0,45,90,135,180].forEach(v=>{g+=`<line x1="${L}" x2="${W-R}" y1="${y(v)}" y2="${y(v)}" stroke="#E2E5E9"/><text x="${L-8}" y="${y(v)+4}" text-anchor="end">${v}萬</text>`});
 [0,0.5,1,1.5,2].forEach(v=>{g+=`<text x="${x(v)}" y="${H-12}" text-anchor="middle">+${v.toFixed(1)} 元</text>`});
 g+=`</g>`;
 g+=`<line x1="${x(0)}" y1="${y(0)}" x2="${x(2)}" y2="${y(gr(2))}" stroke="#8A929B" stroke-width="1.5" stroke-dasharray="2 4"/>`;
 g+=`<line x1="${x(0)}" y1="${y(0)}" x2="${x(2)}" y2="${y(un(2))}" stroke="#A86400" stroke-width="2.5"/>`;
 g+=`<line x1="${x(0)}" y1="${y(0)}" x2="${x(2)}" y2="${y(he(2))}" stroke="#16765A" stroke-width="2.5" stroke-dasharray="6 5"/>`;
 g+=`<line x1="${x(S.move)}" x2="${x(S.move)}" y1="${T}" y2="${y(0)}" stroke="#E61E00" stroke-width="1"/>`;
 g+=`<circle cx="${x(S.move)}" cy="${y(un(S.move))}" r="5" fill="#A86400"/><circle cx="${x(S.move)}" cy="${y(he(S.move))}" r="5" fill="#16765A"/>`;
