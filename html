 g+=`</g>`;
 rows.forEach((o,i)=>{const x=L+i*bw+bw*.28,w=bw*.44,hv=S.executed?lockOf(o):0,nt=net(o),uv=nt-hv;
  if(hv>0)g+=`<rect x="${x}" y="${y(hv)}" width="${w}" height="${y(0)-y(hv)}" fill="#3A4047"><title>${o.id} 已鎖匯 ${usd(hv)}</title></rect>`;
  g+=`<rect x="${x}" y="${y(hv+uv)}" width="${w}" height="${y(hv)-y(hv+uv)}" fill="#E61E00"><title>${o.id} 未避險淨曝險 ${usd(uv)}</title></rect>`;
  g+=`<rect x="${x}" y="${y(o.amt)}" width="${w}" height="${y(nt)-y(o.amt)}" fill="url(#nat)" rx="2"><title>${o.id} 美元進貨（自然避險）${usd(o.cost)}</title></rect>`;
  g+=`<text x="${x+w/2}" y="${y(o.amt)-7}" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="13" font-weight="500" fill="#1D2125">${usd(o.amt)}</text>`;
  g+=`<text x="${x+w/2}" y="${H-20}" text-anchor="middle" font-size="13" fill="#3A4047">${o.col}</text><text x="${x+w/2}" y="${H-5}" text-anchor="middle" font-size="11" fill="#8A929B" font-family="IBM Plex Mono, monospace">${o.id}</text>`});
 return g+`</svg>`;
}
function sensChart(){
