<title>豐匯通 Demo</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700;900&display=swap">
<style>
/* Layout: corporate e-banking shell — charcoal nav rail, working canvas, AI co-pilot drawer; a guided-tour bar for judges along the bottom.
   Single light theme by choice (corporate banking console), every color set explicitly. */
:root{
  color-scheme:light;
  --brand:#E61E00; --brand-deep:#B51800; --brand-soft:#FDEBE6; --brand-line:#F6C4B8;
  --ink:#1D2125; --ink-2:#3A4047; --muted:#646C75; --faint:#8A929B;
  --line:#E2E5E9; --line-2:#D3D7DC; --bg:#F3F4F6; --surface:#FFFFFF; --sunk:#F7F8F9;
  --rail:#1F2327; --rail-2:#2A2F34; --rail-ink:#C9CED4;
  --risk:#A86400; --risk-soft:#FFF4E0; --safe:#16765A; --safe-soft:#E4F3EC; --info:#2F5E8C; --info-soft:#E8F0F8;
  --sans:"IBM Plex Sans","Noto Sans TC","PingFang TC","Microsoft JhengHei",system-ui,sans-serif;
  --tc:"Noto Sans TC","PingFang TC","Microsoft JhengHei",system-ui,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
  --r:10px;
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:14px;line-height:1.55;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:14px 96px}
button{font:inherit;color:inherit}
.num{font-variant-numeric:tabular-nums}
.mono{font-family:var(--mono)}

.notice{max-width:1480px;margin:0 auto 10px;display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center;font-size:12.5px;color:var(--muted)}
.notice b{color:var(--ink);font-weight:600}
.notice .pill{background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:2px 10px}

.app{max-width:1480px;margin:0 auto;display:grid;grid-template-columns:236px minmax(0,1fr) 352px;background:var(--surface);
  border:1px solid var(--line-2);border-radius:14px;overflow:hidden;min-height:820px;box-shadow:0 30px 60px -40px rgba(20,24,28,.35)}
.app.noai{grid-template-columns:236px minmax(0,1fr)}
.app.noai .ai{display:none}

/* rail */
.rail{background:var(--rail);color:var(--rail-ink);display:flex;flex-direction:column;padding:20px 14px;gap:22px}
.brand{display:flex;flex-direction:column;gap:2px;padding:0 8px}
.brand .wm{font-family:var(--tc);font-weight:900;font-size:24px;color:#fff;letter-spacing:.04em;display:flex;align-items:center;gap:9px}
.brand .wm i{width:10px;height:10px;background:var(--brand);border-radius:2px;transform:rotate(45deg);display:inline-block}
.brand small{font-size:12px;color:#9AA1A9;letter-spacing:.06em}
.nav{display:flex;flex-direction:column;gap:2px}
.nav .grp{font-size:11px;letter-spacing:.12em;color:#7D858E;padding:12px 10px 6px}
.nav button{all:unset;cursor:pointer;display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:8px;font-family:var(--tc);font-size:14px;color:var(--rail-ink)}
.nav button:hover{background:var(--rail-2);color:#fff}
.nav button[aria-current="page"]{background:var(--rail-2);color:#fff}
.nav button[aria-current="page"] .ix{background:var(--brand);color:#fff;border-color:var(--brand)}
.nav .ix{width:22px;height:22px;border-radius:6px;border:1px solid #444B53;display:grid;place-items:center;font-size:11px;font-family:var(--mono);flex:none}
.nav .badge{margin-left:auto;background:var(--brand);color:#fff;font-size:11px;border-radius:999px;padding:0 7px;line-height:18px}
.nav button:focus-visible,.btn:focus-visible,.chip-btn:focus-visible,.tab:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
.rail .acct{margin-top:auto;border-top:1px solid #33393F;padding:14px 8px 0;font-size:12px;color:#9AA1A9;display:flex;flex-direction:column;gap:3px}
.rail .acct b{color:#fff;font-family:var(--tc);font-weight:500;font-size:13px}

/* main */
.main{display:flex;flex-direction:column;min-width:0;background:var(--bg)}
.top{display:flex;align-items:center;gap:16px;padding:14px 26px;background:var(--surface);border-bottom:1px solid var(--line);flex-wrap:wrap}
.crumb{font-size:12.5px;color:var(--muted)}
.top h1{font-family:var(--tc);font-size:20px;font-weight:700;margin:0;line-height:1.2}
.top .sp{margin-left:auto;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.rate{display:flex;flex-direction:column;align-items:flex-end;font-size:11.5px;color:var(--muted);line-height:1.3}
.rate b{font-family:var(--mono);font-size:15px;color:var(--ink);font-weight:500}
.user{display:flex;align-items:center;gap:8px;font-size:13px;font-family:var(--tc)}
.av{width:32px;height:32px;border-radius:50%;background:var(--ink-2);color:#fff;display:grid;place-items:center;font-weight:700;font-size:13px}
.content{padding:22px 26px 30px;display:flex;flex-direction:column;gap:18px;min-width:0}

.btn{appearance:none;border:1px solid transparent;border-radius:8px;padding:9px 16px;font-weight:600;cursor:pointer;font-family:var(--tc);font-size:14px;display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
.btn.pri{background:var(--brand);color:#fff}
.btn.pri:hover{background:var(--brand-deep)}
.btn.sec{background:var(--surface);border-color:var(--line-2);color:var(--ink)}
.btn.sec:hover{border-color:var(--ink-2)}
.btn.ghost{background:transparent;color:var(--brand-deep);padding:6px 4px}
.btn[disabled]{background:var(--line);color:var(--faint);cursor:not-allowed}

.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:18px 20px;display:flex;flex-direction:column;gap:12px;min-width:0}
.card h2{font-family:var(--tc);font-size:16px;font-weight:700;margin:0;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.card h2 .sub{font-size:12.5px;font-weight:400;color:var(--muted)}
.card .hd{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap}

.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:16px 18px;display:flex;flex-direction:column;gap:6px;min-width:0}
.kpi .k{font-size:12.5px;color:var(--muted);font-family:var(--tc)}
.kpi .v{font-size:28px;font-weight:600;letter-spacing:-.01em;font-variant-numeric:tabular-nums;line-height:1.1}
.kpi .v small{font-size:14px;font-weight:500;color:var(--muted);margin-left:4px}
.kpi .f{font-size:12.5px;color:var(--muted)}
.kpi.alert{border-color:var(--brand-line);background:linear-gradient(180deg,var(--brand-soft),var(--surface) 70%)}
.kpi.alert .v{color:var(--brand-deep)}
.risk{color:var(--risk)} .safe{color:var(--safe)}

.grid2{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:18px}
.grid3{display:grid;grid-template-columns:260px minmax(0,1.2fr) minmax(0,1fr);gap:18px}

.tag{display:inline-flex;align-items:center;gap:5px;font-size:12px;border-radius:999px;padding:2px 9px;font-weight:500;white-space:nowrap;font-family:var(--tc)}
.tag.ok{background:var(--safe-soft);color:var(--safe)}
.tag.warn{background:var(--risk-soft);color:var(--risk)}
.tag.wait{background:var(--sunk);color:var(--muted);border:1px solid var(--line)}
.tag.red{background:var(--brand-soft);color:var(--brand-deep)}
.tag.info{background:var(--info-soft);color:var(--info)}

table.t{width:100%;border-collapse:collapse;font-size:13.5px}
table.t th{font-weight:500;color:var(--muted);font-size:12px;text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);white-space:nowrap;font-family:var(--tc)}
table.t td{padding:11px 10px;border-bottom:1px solid var(--line);vertical-align:middle}
table.t tr:last-child td{border-bottom:0}
table.t .r{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
table.t td.mono{white-space:nowrap}
table.t td:first-child{min-width:7.5em}
.tw{overflow-x:auto}

.legend{display:flex;gap:14px;font-size:12px;color:var(--muted);flex-wrap:wrap}
.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:-1px}

.ai-hint{display:flex;gap:12px;align-items:flex-start;border:1px solid var(--brand-line);background:var(--brand-soft);border-radius:var(--r);padding:14px 16px}
.ai-hint .dot{width:30px;height:30px;border-radius:8px;background:var(--brand);color:#fff;display:grid;place-items:center;font-weight:700;font-size:12px;flex:none;font-family:var(--mono)}
.ai-hint p{margin:0}
.ai-hint .act{margin-left:auto;align-self:center}

/* inbox */
.inbox{display:flex;flex-direction:column;gap:6px}
.mail{all:unset;cursor:pointer;display:flex;flex-direction:column;gap:2px;padding:11px 12px;border-radius:8px;border:1px solid var(--line);background:var(--surface)}
.mail[aria-current="true"]{border-color:var(--brand);box-shadow:inset 3px 0 0 var(--brand)}
.mail .fr{font-size:12px;color:var(--muted)}
.mail b{font-family:var(--mono);font-size:13.5px;font-weight:500}
.mail .row{display:flex;justify-content:space-between;align-items:center;gap:6px}

/* PO document */
.paper{background:#FCFCFA;border:1px solid var(--line-2);border-radius:6px;padding:26px 28px;font-family:"Times New Roman",Georgia,serif;color:#222;font-size:13px;line-height:1.6;box-shadow:0 1px 0 var(--line),0 12px 24px -20px rgba(0,0,0,.4);min-width:0}
.paper .ph{display:flex;justify-content:space-between;border-bottom:2px solid #222;padding-bottom:8px;margin-bottom:12px;gap:10px;flex-wrap:wrap}
.paper .ph b{font-size:18px;letter-spacing:.08em}
.paper table{width:100%;border-collapse:collapse;margin:10px 0;font-size:12.5px}
.paper td,.paper th{border:1px solid #bbb;padding:5px 7px;text-align:left}
.hl{background:rgba(22,118,90,.13);border-bottom:2px solid var(--safe);padding:0 2px;border-radius:2px}
.hl.low{background:rgba(168,100,0,.16);border-bottom-color:var(--risk)}
.hl.on{outline:2px solid var(--brand);outline-offset:1px}

.fields{display:flex;flex-direction:column}
.field{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 10px;padding:11px 0;border-bottom:1px solid var(--line);align-items:center}
.field:last-child{border-bottom:0}
.field .k{font-size:12px;color:var(--muted);font-family:var(--tc)}
.field .v{font-weight:500}
.field.low{background:var(--risk-soft);margin:0 -12px;padding:11px 12px;border-radius:8px;border-bottom:0}
.conf{font-family:var(--mono);font-size:12px}

/* slider */
.ctl{display:flex;flex-direction:column;gap:8px}
.ctl .row{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.ctl .row b{font-family:var(--mono);font-size:16px}
input[type=range]{width:100%;accent-color:var(--brand)}
.ticks{display:flex;justify-content:space-between;font-size:11.5px;color:var(--faint);font-family:var(--mono)}

.big{font-size:40px;font-weight:600;letter-spacing:-.02em;line-height:1;font-variant-numeric:tabular-nums}
.note{font-size:12.5px;color:var(--muted)}
.check{display:flex;gap:10px;align-items:flex-start;font-size:13.5px;font-family:var(--tc)}
.check i{flex:none;width:18px;height:18px;border-radius:5px;display:grid;place-items:center;font-style:normal;font-size:11px;margin-top:2px}
.check i.y{background:var(--safe);color:#fff}
.check i.n{border:1.5px solid var(--risk);background:var(--surface)}

.tl{display:flex;flex-direction:column}
.tl .s{display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:12px;padding-bottom:18px;position:relative}
.tl .s::before{content:"";position:absolute;left:13px;top:28px;bottom:2px;width:2px;background:var(--line)}
.tl .s:last-child::before{display:none}
.tl .s.done::before{background:var(--safe)}
.tl .b{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;font-size:12px;font-weight:700;background:var(--sunk);color:var(--muted);border:1px solid var(--line);z-index:1;font-family:var(--mono)}
.tl .done .b{background:var(--safe);color:#fff;border-color:var(--safe)}
.tl .now .b{background:var(--brand);color:#fff;border-color:var(--brand)}
.tl .s strong{font-family:var(--tc);font-size:14.5px;display:block}
.tl .s span.d{font-size:12.5px;color:var(--muted)}
.tl .s .when{font-size:12px;color:var(--faint);font-family:var(--mono);white-space:nowrap}

.rm{display:flex;gap:12px;align-items:center}
.rm .av{background:var(--brand)}
.msg{background:var(--sunk);border:1px solid var(--line);border-radius:10px;padding:10px 12px;font-size:13.5px;font-family:var(--tc)}

.cmp{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.cmp>div{border:1px solid var(--line);border-radius:var(--r);padding:14px 16px;display:flex;flex-direction:column;gap:4px}
.cmp .k{font-size:12.5px;color:var(--muted);font-family:var(--tc)}
.cmp .v{font-size:22px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}
.cmp .hi{border-color:var(--safe);background:var(--safe-soft)}

/* AI drawer */
.ai{border-left:1px solid var(--line);display:flex;flex-direction:column;min-width:0;background:var(--surface)}
.ai .ah{padding:16px 18px 0;display:flex;align-items:center;gap:10px}
.ai .ah .mk{width:30px;height:30px;border-radius:8px;background:var(--brand);color:#fff;display:grid;place-items:center;font-weight:700;font-size:12px;font-family:var(--mono)}
.ai .ah b{font-family:var(--tc);font-size:15px}
.ai .ah small{display:block;font-size:11.5px;color:var(--safe)}
.tabs{display:flex;gap:4px;padding:12px 18px 0;border-bottom:1px solid var(--line)}
.tab{all:unset;cursor:pointer;padding:8px 10px;font-size:13px;font-family:var(--tc);color:var(--muted);border-bottom:2px solid transparent;margin-bottom:-1px}
.tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--brand);font-weight:600}
.ai .body{flex:1;overflow:auto;padding:16px 18px;display:flex;flex-direction:column;gap:12px;max-height:640px}
.bub{max-width:92%;padding:10px 12px;border-radius:12px;font-size:13.5px;font-family:var(--tc);line-height:1.6}
.bub.ai{background:var(--sunk);border:1px solid var(--line);border-top-left-radius:4px;align-self:flex-start;display:block;width:auto}
.bub.me{background:var(--ink);color:#fff;border-top-right-radius:4px;align-self:flex-end}
.chips{display:flex;flex-wrap:wrap;gap:6px;padding:12px 18px 16px;border-top:1px solid var(--line)}
.chip-btn{all:unset;cursor:pointer;border:1px solid var(--brand-line);color:var(--brand-deep);background:var(--surface);border-radius:999px;padding:5px 11px;font-size:12.5px;font-family:var(--tc)}
.chip-btn:hover{background:var(--brand-soft)}
.log{display:flex;flex-direction:column;gap:0}
.log .e{display:grid;grid-template-columns:44px minmax(0,1fr);gap:10px;padding:9px 0;border-bottom:1px dashed var(--line);font-size:12.5px}
.log .e .tm{font-family:var(--mono);color:var(--faint)}
.log .e b{font-family:var(--tc);font-weight:600;font-size:12.5px;display:block}
.log .e.gate b{color:var(--risk)}
.log .e span{color:var(--ink-2);font-family:var(--tc)}

/* tour */
.tour{position:fixed;left:0;right:0;bottom:0;background:var(--rail);color:#fff;z-index:20;
  padding:12px max(16px,env(safe-area-inset-right,0px)) calc(12px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px))}
.tour .in{max-width:1480px;margin:0 auto;display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.tour .stp{font-family:var(--mono);font-size:12px;color:#fff;background:var(--brand);border-radius:6px;padding:3px 8px;white-space:nowrap}
.tour .tx{flex:1;min-width:240px;font-family:var(--tc);font-size:13.5px;color:#D9DDE1}
.tour .tx b{color:#fff;font-size:14.5px;margin-right:8px}
.tour .btn.sec{background:transparent;color:#fff;border-color:#4A5158}
.tour .bars{display:flex;gap:4px}
.tour .bars i{width:22px;height:4px;border-radius:2px;background:#4A5158}
.tour .bars i.on{background:var(--brand)}
.toast{position:fixed;top:18px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 16px;border-radius:8px;font-family:var(--tc);font-size:13.5px;z-index:30;box-shadow:0 10px 30px -10px rgba(0,0,0,.4)}

@media (max-width:1240px){.app{grid-template-columns:220px minmax(0,1fr)}.app .ai{display:none}.app.aiopen .ai{display:flex;position:fixed;right:0;top:0;bottom:0;width:min(360px,100%);z-index:25;box-shadow:-20px 0 40px -20px rgba(0,0,0,.3)}.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:980px){.grid2,.grid3{grid-template-columns:minmax(0,1fr)}}
@media (max-width:760px){.app,.app.noai{grid-template-columns:minmax(0,1fr)}.rail{padding:14px}.nav{flex-direction:row;overflow-x:auto}.nav .grp{display:none}.rail .acct{display:none}.content{padding:16px}.top{padding:12px 16px}.cmp{grid-template-columns:1fr}.kpis{grid-template-columns:minmax(0,1fr)}}
@media (prefers-reduced-motion:no-preference){.content>*{animation:rise .28s ease-out both}.content>*:nth-child(2){animation-delay:.04s}.content>*:nth-child(3){animation-delay:.08s}@keyframes rise{from{opacity:.55;transform:translateY(6px)}to{opacity:1;transform:none}}}
</style>
<style>
:root{--ml:#3B5FC0;--ml-soft:#E9EEFB;--llm:#0F6B62;--llm-soft:#DDF0EC;--rule:#8A6D1D;--rule-soft:#F6EDD6;--hum:#B51800;--hum-soft:#FDEBE6}
.ly{display:inline-block;font-size:10.5px;font-weight:700;border-radius:4px;padding:0 6px;line-height:17px;font-family:var(--tc);vertical-align:1px;white-space:nowrap}
.ly.llm{background:var(--llm-soft);color:var(--llm)}.ly.ml{background:var(--ml-soft);color:var(--ml)}.ly.rule{background:var(--rule-soft);color:var(--rule)}.ly.hum{background:var(--hum-soft);color:var(--hum)}
.layers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.lay{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:14px 16px;display:flex;flex-direction:column;gap:6px;min-width:0}
.lay b{font-family:var(--tc);font-size:14.5px}.lay span.d{font-size:12.5px;color:var(--muted);font-family:var(--tc)}
.pdrow{all:unset;cursor:pointer;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 12px;padding:12px 14px;border:1px solid var(--line);border-radius:8px;background:var(--surface)}
.pdrow[aria-current="true"]{border-color:var(--ml);box-shadow:inset 3px 0 0 var(--ml)}
.pdrow:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
.pdrow .id{font-family:var(--mono);font-size:13.5px;font-weight:500}
.pdrow .by{font-size:12.5px;color:var(--muted)}
.pdrow .pv{font-family:var(--mono);font-size:24px;font-weight:500;text-align:right;line-height:1.1}
.pdrow .gauge{grid-column:1/-1}
.gauge{position:relative;height:8px;border-radius:4px;border:1px solid var(--line);background:linear-gradient(90deg,var(--safe-soft) 0 33.33%,var(--risk-soft) 33.33% 66.66%,var(--brand-soft) 66.66% 100%)}
.gauge i{position:absolute;top:-5px;width:4px;height:16px;background:var(--ink);border-radius:2px;transform:translateX(-50%)}
.gscale{display:flex;justify-content:space-between;font-size:11px;color:var(--faint);font-family:var(--mono)}
.sh{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(90px,1fr) 48px;gap:10px;align-items:center;padding:7px 0;border-bottom:1px solid var(--line);font-size:13px;font-family:var(--tc)}
.sh:last-child{border-bottom:0}
.sh .tr{position:relative;height:14px;background:var(--sunk);border-radius:4px}
.sh .ax{position:absolute;left:50%;top:-3px;bottom:-3px;width:1px;background:var(--line-2)}
.sh .tr b{position:absolute;top:2px;bottom:2px;border-radius:2px}
.sh .up{background:var(--brand)}.sh .dn{background:var(--safe)}
.sh .v{text-align:right;font-size:12.5px}
.flow{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-family:var(--tc);font-size:14px}
.flow .big{font-size:30px}
