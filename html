 </section>
 <section class="card"><h2>這筆訂單的匯率成績單</h2>
  <div class="cmp"><div><span class="k">若完全不避險</span><span class="v">${wan(unh)} 萬</span><span class="note">淨曝險部分以即期 ${spotAt.toFixed(2)} 結匯</span></div><div class="hi"><span class="k">實際收到（鎖匯 ${(h/nt*100).toFixed(0)}%）</span><span class="v safe">${wan(actual)} 萬</span><span class="note">多收 ${wan(actual-unh)} 萬</span></div></div>
  <p class="note" style="margin:0">接單時以 30.50 報價，淨曝險部分預期 ${wan(quote)} 萬。實際少收 ${wan(quote-actual)} 萬，若未避險則少收 ${wan(quote-unh)} 萬。</p>
  <button class="btn sec" data-act="restart">重新開始 Demo</button>
 </section></div>`};

/* ---------- AI chat ---------- */
const CHAT={
 home:{say:`早安，陳董事長。今天收到 3 張轉寄的美元訂單，合計 ${usd(GROSS)}，扣除美元進貨後淨曝險 ${usd(NET)}。目前全部未避險，新台幣每升值 1 元，約少收 NT$${wan(NET)} 萬。`,
  chips:[["帶我去確認訂單",()=>go("read")],["我的匯率風險有多大？",()=>{say("我的匯率風險有多大？",`三張訂單會在 2027 年 1 至 3 月陸續收款。以淨曝險計算，新台幣升值 1 元約少收 NT$${wan(NET)} 萬，約占這批訂單毛利的 ${(NET/GP*100).toFixed(0)}%。若以訂單全額計算（曝險上限），則為 ${wan(GROSS)} 萬，約 ${(GROSS/GP*100).toFixed(0)}%。`);go("risk",true)}]]},
 read:{say:"NL-2611 的付款條件原文是「T/T 60 days after B/L date」，以提單日起算。若 12/10 出貨，預計 2027-02-08 收款。請您確認這個欄位。",
  chips:[["確認無誤",()=>act("confirm")],["為什麼信心只有 87%？",()=>say("為什麼信心只有 87%？","這份訂單以「B/L date」起算，和您過去常見的「出貨後」寫法不同，同一行還有預付款條款。我無法完全確定，因此請您確認，不會自行推測。")]]},
 risk:{say:"我已扣除您以美元支付的原料進貨，只計算實際承擔的淨曝險。拖動左邊的升值情境，可以看到少收金額與占毛利的比例。這裡只呈現情境，不預測匯率。",
  chips:[["如果升值 2 元呢？",()=>{S.move=2;say("如果升值 2 元呢？",`升值 2 元時，淨曝險少收約 NT$${wan(NET*2)} 萬，約占毛利 ${(NET*2/GP*100).toFixed(0)}%。若依建議鎖匯 ${S.hedge}%，少收金額可降到 NT$${wan((NET-planUsd())*2)} 萬。`)}],["為什麼要扣除美元進貨？",()=>say("為什麼要扣除美元進貨？","您以美元支付的原料，會和美元收入互相抵銷，匯率變動對這一部分沒有影響。只對淨曝險鎖匯，可以避免避險過度。")],["看買方付款風險",()=>go("pd")]]},
 pd:{say:`我用機器學習模型預估各買方的付款風險。MX-0415 是首次交易的買方，風險最高（${pdOf(ORDERS[2]).toFixed(1)}%），但仍低於 ${REVIEW}% 的 RM 複核門檻。`,
  chips:[["為什麼 MX-0415 較高？",()=>say("為什麼 MX-0415 較高？","主要因為首次交易、沒有歷史付款紀錄，且缺少公開財報評等，三項合計拉高約 9.3 個百分點。點選右側 SHAP 圖可以逐項查看。")],["這會如何影響建議？",()=>say("這會如何影響建議？","付款風險越高，訂單越可能延遲或取消，鎖匯比例就越低，以免遠期合約與實際收款不符。MX-0415 建議只鎖 25%，另外兩筆鎖 55%。付款風險也會作為週轉金預審的依據。")],["看避險建議",()=>go("plan")]]},
 plan:{say:"建議依各訂單淨曝險與付款風險分 3 筆遠期外匯，整體約鎖 50%，並為 NL-2611 準備 NT$800 萬的出貨前週轉金。鎖匯金額不會超過淨曝險。",
  chips:[["鎖 70% 會怎樣？",()=>{if(S.submitted){say("鎖 70% 會怎樣？","方案已送出，若要調整請 RM 協助。");return}S.hedge=70;say("鎖 70% 會怎樣？",`整體鎖 70% 時，升值 1 元的少收金額降到約 NT$${wan(NET-planUsd())} 萬。缺點是新台幣若反而貶值，鎖住的部分享受不到貶值的好處，訂單若取消，也需要處理到期的合約。`)}],
   ["遠期外匯是什麼？",()=>say("遠期外匯是什麼？","就是現在先和銀行約定，未來某一天用固定匯率把美元換成新台幣。好處是收款時不論匯率如何變動，這部分的金額都已確定，代價是匯率往有利方向變動時，這部分也不會多賺。")],
   ["送給 RM 確認",()=>act("submit")]]},
 prog:{say:"方案已送到王經理的工作台。RM 確認適合度、授信核准後才會成交，這一步不會由我自動完成。",
  chips:[["模擬 RM 完成確認",()=>act("rm")],["模擬收到 NL-2611 貨款",()=>act("settle")]]},
 recon:{say:"收款時我會自動比對訂單、交割遠期、償還週轉金，並整理每筆訂單的匯率成績單。",
  chips:[["重新開始 Demo",()=>act("restart")]]}
};
function say(q,a){if(q)S.chat.push({me:true,t:q});S.chat.push({me:false,t:a});render()}
function intro(){if(!S.seen[S.page]){S.seen[S.page]=1;S.chat.push({me:false,t:CHAT[S.page].say})}}

/* ---------- actions ---------- */
let toastT;
function toast(t){let el=document.querySelector(".toast");if(!el){el=document.createElement("div");el.className="toast";el.setAttribute("role","status");document.body.appendChild(el)}el.textContent=t;el.hidden=false;clearTimeout(toastT);toastT=setTimeout(()=>{el.hidden=true},2600)}
function act(a){
 if(a==="confirm"&&!S.confirmed){S.confirmed=true;addLog("協調 Agent","陳董事長確認 NL-2611 付款條件，交由曝險試算引擎",true);addLog("曝險試算引擎",`以即期 30.50 計算：訂單 ${usd(GROSS)}，扣除美元進貨 ${usd(COST)}，淨曝險 ${usd(NET)}`);addLog("付款風險模型",`完成 3 位買方評分：NL-2611 ${pdOf(ORDERS[0]).toFixed(1)}%、PR-7730 ${pdOf(ORDERS[1]).toFixed(1)}%、MX-0415 ${pdOf(ORDERS[2]).toFixed(1)}%`);toast("已確認，淨曝險與付款風險已更新");S.chat.push({me:false,t:"謝謝確認。三張訂單都已就緒，淨曝險與買方付款風險也算好了。"});go("risk",true);return}
 if(a==="submit"&&!S.submitted){if(!S.confirmed){toast("請先確認 NL-2611 的付款條件");go("read");return}S.submitted=true;addLog("建議 Agent",`產生草案：遠期外匯鎖匯 ${(planUsd()/NET*100).toFixed(0)}%（依付款風險分配）、週轉金 NT$800 萬`);addLog("協調 Agent","草案送至 RM 工作台，等待適合度確認",true);toast("已送給王經理確認");go("prog",true);return}
 if(a==="rm"){if(!S.submitted){toast("請先在「避險與融資」送出方案");go("plan");return}if(!S.executed){S.executed=true;addLog("RM 王經理","完成適合度確認與授信核准",true);addLog("協調 Agent","遠期外匯 3 筆成交，週轉金撥款排程");toast("RM 已確認，遠期外匯成交");S.chat.push({me:false,t:"王經理已確認，3 筆遠期外匯成交。總覽頁的未避險部位已更新。"})}render();return}
 if(a==="settle"){if(!S.executed){toast("需要 RM 確認並成交後，才能模擬收款");return}S.settled=true;addLog("對帳 Agent","收到 US$480,000，比對 NL-2611 相符，交割遠期並償還週轉金");toast("貨款已入帳並完成對帳");go("recon",true);return}
 if(a==="restart"){Object.assign(S,{page:"home",move:1,hedge:50,confirmed:false,submitted:false,executed:false,settled:false,chat:[],seen:{},log:S.log.slice(0,3),sel:"NL-2611",hl:null});render();return}
}
function go(p,keep){S.page=p;S.hl=null;render();document.getElementById("page").scrollIntoView({block:"start",behavior:"smooth"})}

/* ---------- render ---------- */
function render(){
 intro();
 const pg=PAGES.find(p=>p.id===S.page);
 document.getElementById("nav").innerHTML=`<div class="grp">出口訂單副駕</div>`+PAGES.map(p=>`<button data-go="${p.id}" ${p.id===S.page?'aria-current="page"':''}><span class="ix">${p.ix}</span>${p.name}${p.id==="read"&&!S.confirmed?'<span class="badge">1</span>':''}</button>`).join("");
 document.getElementById("crumb").textContent=pg.crumb;document.getElementById("title").textContent=pg.title;
 document.getElementById("page").innerHTML=P[S.page]();
 const app=document.getElementById("app");app.classList.toggle("noai",!S.ai);app.classList.toggle("aiopen",S.ai);
 document.getElementById("aiToggle").setAttribute("aria-pressed",S.ai);
 document.querySelectorAll(".tab").forEach(t=>t.setAttribute("aria-selected",t.dataset.tab===S.tab));
 const body=document.getElementById("aibody");
 body.innerHTML=S.tab==="chat"?S.chat.map(m=>`<div class="bub ${m.me?'me':'ai'}">${m.t}</div>`).join(""):
  `<div class="log">${S.log.map(e=>{const l=LAYER[e.agent]||["llm","LLM"];return `<div class="e ${e.gate?'gate':''}"><span class="tm">${e.tm}</span><div><b>${e.agent}<span class="ly ${l[0]}">${l[1]}</span>${e.gate?'，人工關卡':''}</b><span>${e.text}</span></div></div>`}).join("")}</div><p class="note">每次讀單、試算、評分、建議都留存紀錄，供稽核使用。</p>`;
 body.scrollTop=body.scrollHeight;
 document.getElementById("chips").innerHTML=S.tab==="chat"?CHAT[S.page].chips.map((c,i)=>`<button class="chip-btn" data-chip="${i}">${c[0]}</button>`).join(""):"";
 const idx=PAGES.findIndex(p=>p.id===S.page);
 document.getElementById("tstep").textContent=`DEMO 導覽 ${idx+1} / ${PAGES.length}`;
 document.getElementById("tbars").innerHTML=PAGES.map((_,i)=>`<i class="${i<=idx?'on':''}"></i>`).join("");
 document.getElementById("ttext").innerHTML=`<b>${TOUR[S.page][0]}</b>${TOUR[S.page][1]}`;
 document.getElementById("tprev").disabled=idx===0;
 document.getElementById("tnext").textContent=idx===PAGES.length-1?"重新開始":"下一步";
}
function tourNext(){const i=PAGES.findIndex(p=>p.id===S.page);
 if(S.page==="read"&&!S.confirmed){act("confirm");return}
 if(S.page==="plan"&&!S.submitted){act("submit");return}
 if(S.page==="prog"&&!S.executed){act("rm");return}
 if(S.page==="prog"&&!S.settled){act("settle");return}
 if(i===PAGES.length-1){act("restart");return}
 go(PAGES[i+1].id)}

document.addEventListener("click",e=>{
 const b=e.target.closest("button,[data-hl]");if(!b)return;
 if(b.dataset.go){go(b.dataset.go);return}
 if(b.dataset.act){act(b.dataset.act);return}
 if(b.dataset.sel){S.sel=b.dataset.sel;render();return}
 if(b.dataset.chip!==undefined){CHAT[S.page].chips[+b.dataset.chip][1]();return}
 if(b.dataset.tab){S.tab=b.dataset.tab;render();return}
 if(b.dataset.hl){S.hl=S.hl===b.dataset.hl?null:b.dataset.hl;render();return}
 if(b.id==="aiToggle"){S.ai=!S.ai;render();return}
 if(b.id==="tnext"){tourNext();return}
 if(b.id==="tprev"){const i=PAGES.findIndex(p=>p.id===S.page);if(i>0)go(PAGES[i-1].id);return}
});
document.addEventListener("input",e=>{
 if(e.target.id==="move"){S.move=+e.target.value;render();document.getElementById("move").focus()}
 if(e.target.id==="hedge"){S.hedge=+e.target.value;render();document.getElementById("hedge").focus()}
});
const h=(location.hash||"").slice(1);if(PAGES.some(p=>p.id===h))S.page=h;
if(window.matchMedia("(max-width:1240px)").matches)S.ai=false;
render();
</script>

